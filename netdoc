#!/usr/bin/env bash
# netdoc — ネットワークドクター
#
#   Web・動画・ダウンロードの遅さを切り分け、根拠のある修復と再測定を行う。
#   Wi-Fi → ルーター → 外部回線、DNS、VPN、アプリ通信量を比較する。
#   LLM の接続不良は --llm で DNS → TCP → TLS → HTTP を調べる。
#
# 使い方:
#   netdoc                 対話モード（診断 → 修復メニュー）
#   netdoc --check         診断のみ。何もいじらない
#   netdoc --fix           速度診断 → 根拠のある修復 → 再測定・復元
#   netdoc --plan          速度診断と修復候補だけ（設定変更なし）
#   netdoc --auto          根拠のある軽い修復を無人で実行
#   netdoc --llm           LLM への疎通だけを段階で調べる
#   netdoc --speed         回線速度・負荷時遅延・アプリ通信量を測る
#   netdoc --full          速度・LLMまで含めた診断のみ（設定変更なし）
#   netdoc --stream        LLMのストリーミング初動を実測（モデルを起こします）
#   netdoc --history       この網での過去の記録と比較
#   netdoc --where         いまどこに居るか（IP・ISP・Wi-Fi・経路）だけ
#   netdoc --json          全結果を JSON で出す（機械可読）
#   netdoc --report [PATH] Markdown レポートを書き出す
#   netdoc --watch [SEC]   定期監視。状態が変わったときだけ表示
#   netdoc --targets       調べに行く先の一覧（~/.netdoc/targets.conf）
#   netdoc --discover      tailnet と手元から LLM サーバを探して登録する
#   netdoc --restore [ID]  記録したDNS設定を元に戻す（既定: 最新）
#   netdoc --restore-dns   記録したDNS変更を元に戻す
#   netdoc --pause PID [秒] 指定プロセスを一時停止して自動復帰（既定60秒）
#
# bash 3.2 と macOS 標準コマンドで動く。lib/ を含めて配置する。

set -uo pipefail

VERSION="0.4.0"
MODE="interactive"
REPORT_PATH=""
WATCH_SEC=60
RESTORE_ID=""
PAUSE_PID=""
PAUSE_SEC=60

case "${1:-}" in
  --auto)    MODE="auto" ;;
  --fix)     MODE="fix" ;;
  --plan)    MODE="plan" ;;
  --restore) MODE="restore"; RESTORE_ID="${2:-}" ;;
  --pause)   MODE="pause"; PAUSE_PID="${2:-}"; PAUSE_SEC="${3:-60}" ;;
  --check)   MODE="check" ;;
  --llm)     MODE="llm" ;;
  --speed)   MODE="speed" ;;
  --full)    MODE="full" ;;
  --stream)  MODE="stream" ;;
  --history) MODE="history" ;;
  --where)   MODE="where" ;;
  --json)    MODE="json" ;;
  --targets) MODE="targets" ;;
  --report)  MODE="report"; REPORT_PATH="${2:-$HOME/netdoc-$(date +%Y%m%d-%H%M%S).md}" ;;
  --watch)   MODE="watch"; WATCH_SEC="${2:-60}" ;;
  --restore-dns) MODE="restore-dns" ;;
  --discover)    MODE="discover" ;;
  -v|--version) echo "netdoc $VERSION"; exit 0 ;;
  -h|--help) sed -n '2,/^set -uo pipefail/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
  "") ;;
  *) echo "不明なオプション: $1  （netdoc --help）" >&2; exit 2 ;;
esac

case "$MODE" in
  report|watch|restore) [ "$#" -le 2 ] || { echo "引数が多すぎます" >&2; exit 2; } ;;
  pause) [ "$#" -ge 2 ] && [ "$#" -le 3 ] || { echo "使い方: netdoc --pause PID [秒]" >&2; exit 2; } ;;
  *) [ "$#" -le 1 ] || { echo "オプションは一度に1つ指定してください" >&2; exit 2; } ;;
esac
case "$WATCH_SEC" in ''|*[!0-9]*) echo "監視間隔は正の整数です" >&2; exit 2 ;; esac
[ "$WATCH_SEC" -ge 1 ] || { echo "監視間隔は1秒以上です" >&2; exit 2; }

# Resolve the installed ~/bin/netdoc symlink before loading adjacent libraries.
NETDOC_SOURCE="${BASH_SOURCE[0]}"
NETDOC_LINKS=0
while [ -L "$NETDOC_SOURCE" ]; do
  NETDOC_LINKS=$((NETDOC_LINKS+1))
  [ "$NETDOC_LINKS" -le 40 ] || { echo "netdoc: symlink loop" >&2; exit 2; }
  NETDOC_DIR=$(cd -P "$(dirname "$NETDOC_SOURCE")" && pwd) || exit 2
  NETDOC_SOURCE=$(readlink "$NETDOC_SOURCE")
  case "$NETDOC_SOURCE" in /*) ;; *) NETDOC_SOURCE="$NETDOC_DIR/$NETDOC_SOURCE" ;; esac
done
NETDOC_DIR=$(cd -P "$(dirname "$NETDOC_SOURCE")" && pwd) || exit 2
for NETDOC_LIB in core quality repair; do
  [ -r "$NETDOC_DIR/lib/$NETDOC_LIB.sh" ] || {
    echo "netdoc: lib/$NETDOC_LIB.sh がありません。リポジトリ全体を配置してください。" >&2; exit 2;
  }
done
. "$NETDOC_DIR/lib/core.sh"

# ─── 装飾 ────────────────────────────────────────────────
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "$MODE" != "json" ]; then
  RED=$'\033[31m'; GRN=$'\033[32m'; YLW=$'\033[33m'; BLU=$'\033[34m'
  CYA=$'\033[36m'; DIM=$'\033[2m'; BLD=$'\033[1m'; RST=$'\033[0m'
else
  RED=''; GRN=''; YLW=''; BLU=''; CYA=''; DIM=''; BLD=''; RST=''
fi
Q="$MODE"; [ "$Q" = "json" ] && exec 3>&1 1>/dev/null || exec 3>/dev/null
ok()   { printf "  ${GRN}✓${RST} %s\n" "$*"; }
ng()   { printf "  ${RED}✗${RST} %s\n" "$*"; }
warn() { printf "  ${YLW}!${RST} %s\n" "$*"; }
info() { printf "  ${BLU}ℹ${RST} %s\n" "$*"; }
note() { printf "    ${DIM}%s${RST}\n" "$*"; }
step() { printf "\n${BLD}▶ %s${RST}\n" "$*"; }
hr()   { printf "${DIM}────────────────────────────────────────────────────────${RST}\n"; }

ask() {
  local q="$1" def="${2:-N}" ans
  [ "$MODE" = "auto" ] && return 1
  [ -t 0 ] || return 1
  case "$MODE" in check|llm|speed|where|json|report|watch|targets|stream|history|full|plan) return 1 ;; esac
  if [ "$def" = "Y" ]; then
    read -r -p "$(printf "  ${YLW}?${RST} %s ${DIM}[Y/n]${RST} " "$q")" ans
    [ -z "$ans" ] || echo "$ans" | grep -qi '^y'
  else
    read -r -p "$(printf "  ${YLW}?${RST} %s ${DIM}[y/N]${RST} " "$q")" ans
    echo "$ans" | grep -qi '^y'
  fi
}

# ─── 結果の記録（bash3.2に連想配列が無いのでTSVに貯める）──────
FACTS="$(mktemp -t netdoc.facts)"
FIND="$(mktemp -t netdoc.find)"     # 所見（原因の候補）
netdoc_cleanup() {
  local status=$?
  trap - EXIT INT TERM HUP
  if declare -F repair_cleanup >/dev/null; then repair_cleanup; fi
  rm -f "$FACTS" "$FIND"
  exit "$status"
}
trap netdoc_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
fact()   { printf '%s\t%s\n' "$(printf '%s' "$1" | tr '\t\r\n' '   ')" "$(printf '%s' "$2" | tr '\t\r\n' '   ')" >>"$FACTS"; }   # key<TAB>value
getf()   { awk -F'\t' -v k="$1" '$1==k{v=$2} END{print v}' "$FACTS"; }
# finding <優先度> <深刻度> <タイトル> <対処>
#   優先度は小さいほど「LLMに繋がらない」の直接原因に近い。
#   10=通信が成立していない / 20=成立するが壊れている / 30=相手側や認証 / 40=遅い・細い
finding(){ printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$(printf '%s' "$3" | tr '\t\r\n' '   ')" "$(printf '%s' "$4" | tr '\t\r\n' '   ')" >>"$FIND"; }

NOW="$(date '+%Y-%m-%d %H:%M:%S')"
fact ts "$NOW"; fact version "$VERSION"

# ─── 設定（調べに行く先）──────────────────────────────────
CONF_DIR="${NETDOC_HOME:-$HOME/.netdoc}"
TARGETS="$CONF_DIR/targets.conf"
seed_targets() {
  mkdir -p "$CONF_DIR"
  {
    echo "# netdoc が疎通を調べに行く先。1行1件。"
    echo "# 形式: 名前 | URL | 種別(http|ollama|openai|tcp)"
    echo "# 種別 ollama なら /api/tags を読んでモデル数まで確認する。"
    echo "# 種別 openai なら /v1/models を読む（persona-node もこれ）。"
    echo "# ここに自分の LLM サーバを足すと、まとめて面倒を見る。"
    echo
    echo "Anthropic API      | https://api.anthropic.com/          | http"
    echo "claude.ai          | https://claude.ai/                  | http"
    echo "ollama (ローカル)   | http://127.0.0.1:11434             | ollama"
    # 手元で動いていそうなものを初回に拾っておく
    if curl -s -o /dev/null --max-time 2 http://127.0.0.1:8787/healthz 2>/dev/null; then
      echo "persona-node       | http://127.0.0.1:8787              | openai"
    fi
    echo
    echo "# tailnet 上のLLMサーバは  netdoc --discover  で探して追記できます。"
  } >"$TARGETS"
}
tailscale_ips() { :; }   # 後で本体を定義する（seed時は空でよい）

HISTORY="$CONF_DIR/history.tsv"

netid() {
  # 「同じ網か」を判定する指紋。SSID か、ゲートウェイのMAC、無ければGW-IP。
  local ssid gw mac
  gw=$(route -n get default 2>/dev/null | awk '/gateway:/{print $2}')
  mac=$(arp -n "$gw" 2>/dev/null | awk '{print $4}' | head -1)
  case "$mac" in ''|'(incomplete)'|'no') mac="" ;; esac
  printf '%s' "${mac:-${gw:-unknown}}|${DEFIF:-unknown}" | cksum | awk '{print $1}'
}

history_note() {
  # 同じ網の前回の記録と比べて、変わったところだけ言う。
  local nid="$1" prev n
  [ -f "$HISTORY" ] || { info "この網は初めてです"; return 0; }
  prev=$(awk -F'\t' -v k="$nid" '$2==k{line=$0} END{print line}' "$HISTORY")
  n=$(awk -F'\t' -v k="$nid" '$2==k{c++} END{print c+0}' "$HISTORY")
  [ -z "$prev" ] && { info "この網は初めてです"; return 0; }
  info "この網は ${n}回目 ${DIM}（前回 $(echo "$prev" | cut -f1)）${RST}"
  local p_rtt p_dns p_down p_bad
  p_rtt=$(echo "$prev" | cut -f4); p_dns=$(echo "$prev" | cut -f5)
  p_down=$(echo "$prev" | cut -f6); p_bad=$(echo "$prev" | cut -f8)
  fact prev_rtt "$p_rtt"; fact prev_dns "$p_dns"; fact prev_down "$p_down"; fact prev_bad "$p_bad"
}

history_save() {
  mkdir -p "$CONF_DIR"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$NOW" "$(getf netid)" "$(getf wifi_ssid)" "$(getf rtt)" "$(getf dns_ms)" \
    "$(getf down_mbps)" "$(getf up_mbps)" "$(getf llm_bad)" >>"$HISTORY"
}

delta() { # delta 今 前 単位 [小さい方が良い=1]
  local now="$1" was="$2" unit="$3" lower="${4:-1}"
  [ -z "$was" ] && return 0
  echo "$now$was" | grep -q '[^0-9.]' && return 0
  awk -v a="$now" -v b="$was" -v u="$unit" -v L="$lower" 'BEGIN{
    if(b==0) exit; d=(a-b)/b*100; if(d<0)d=-d;
    if(d<20) exit;
    worse = (L==1) ? (a>b) : (a<b);
    printf "（前回 %s%s %s）", b, u, (worse ? "から悪化" : "から改善")}'
}

# ─── 小道具 ──────────────────────────────────────────────
TS_BIN=""
for c in "$(command -v tailscale 2>/dev/null)" \
         "/Applications/Tailscale.app/Contents/MacOS/Tailscale" \
         "/usr/local/bin/tailscale" "/opt/homebrew/bin/tailscale"; do
  [ -n "$c" ] && [ -x "$c" ] && { TS_BIN="$c"; break; }
done

msec() { # 秒(小数) → ミリ秒(整数)
  awk -v s="${1:-0}" 'BEGIN{printf "%d", s*1000}'
}
mbps() { # bytes/sec → Mbps(小数1桁)
  awk -v b="${1:-0}" 'BEGIN{printf "%.1f", b*8/1000000}'
}
dwidth() { # 表示幅。全角=2桁。
  # case の文字クラスは UTF-8 ロケールで期待通りに効かないので、
  # 「バイト数と文字数の差」から出す（3バイト文字1つにつき差が2）。
  local str="$1" chars bytes
  chars=${#str}
  bytes=$(printf '%s' "$str" | LC_ALL=C wc -c | tr -d ' ')
  echo $(( chars + (bytes - chars) / 2 ))
}

human_bytes() {
  awk -v b="${1:-0}" 'BEGIN{
    if(b>1073741824) printf "%.1fGB", b/1073741824;
    else if(b>1048576) printf "%.1fMB", b/1048576;
    else if(b>1024) printf "%.0fKB", b/1024; else printf "%dB", b}'
}

# ─── 1. いまどこに居るか ─────────────────────────────────
tailscale_peers() {
  # "IP<TAB>ホスト名" を1行ずつ。--json は整形出力なので plain を使う。
  [ -n "$TS_BIN" ] || return 0
  run_bounded 8 "$TS_BIN" status 2>/dev/null \
    | awk '$1 ~ /^100\./ && $0 !~ /offline/ {printf "%s\t%s\n", $1, $2}'
}
tailscale_ips() { tailscale_peers | cut -f1; }

section_where() {
  step "1. いまどこに居るか"

  DEFIF=$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')
  DEFGW=$(route -n get default 2>/dev/null | awk '/gateway:/{print $2}')
  fact default_if "$DEFIF"; fact gateway "$DEFGW"
  if [ -n "$DEFIF" ]; then
    ok "経路          : ${BLD}$DEFIF${RST} → gw $DEFGW"
  else
    ng "デフォルトルートが無い — ケーブル/Wi-Fi の物理接続から"
    finding 10 critical "デフォルトルートが無い" "ケーブルを挿し直すか Wi-Fi に接続する"
  fi

  # 生きているインターフェースを全部
  ACTIVE=""
  for i in $(ifconfig -l 2>/dev/null); do
    case "$i" in lo0|gif*|stf*|awdl*|llw*|bridge*|ap1) continue ;; esac
    a=$(ipconfig getifaddr "$i" 2>/dev/null)
    [ -z "$a" ] && continue
    mark=" "; [ "$i" = "$DEFIF" ] && mark="*"
    svc=$(networksetup -listnetworkserviceorder 2>/dev/null \
          | awk -v d="Device: $i)" 'index($0,d){print prev} {if($0 ~ /^\([0-9]/) prev=substr($0,index($0,") ")+2)}' | head -1)
    ACTIVE="$ACTIVE$i:$a "
    printf "  %s %-8s %-16s ${DIM}%s${RST}\n" "$mark" "$i" "$a" "${svc:-}"
  done
  fact interfaces "$ACTIVE"
  note "* が現在の経路"

  # Wi-Fi の質（電波が細いと LLM のストリーミングが途切れる）
  # ★system_profiler は数秒かかるので、Wi-Fi で繋がっている時だけ呼ぶ。
  WIFIDEV=$(networksetup -listallhardwareports 2>/dev/null | awk '/Hardware Port: Wi-Fi/{getline; print $2}')
  WIFI=""
  if [ -n "$WIFIDEV" ] && [ "$WIFIDEV" = "${DEFIF:-}" ]; then
    WIFI=$(run_bounded 12 system_profiler SPAirPortDataType 2>/dev/null \
           | awk '/Current Network Information:/{p=1;next} /Other Local Wi-Fi Networks:/{p=0} p')
  fi
  if [ -n "$WIFI" ]; then
    SSID=$(echo "$WIFI" | awk 'NR==1{gsub(/^ +| *:$/,""); print}')
    SIG=$(echo "$WIFI"  | awk -F': ' '/Signal \/ Noise/{print $2}')
    CH=$(echo "$WIFI"   | awk -F': ' '/Channel:/{print $2}')
    RATE=$(echo "$WIFI" | awk -F': ' '/Transmit Rate/{print $2}')
    PHY=$(echo "$WIFI"  | awk -F': ' '/PHY Mode/{print $2}')
    [ -n "$SSID" ] && ok "Wi-Fi         : ${BLD}$SSID${RST}  ${DIM}$PHY ch$CH  $SIG  ${RATE}Mbps${RST}"
    fact wifi_ssid "$SSID"; fact wifi_signal "$SIG"; fact wifi_rate "$RATE"
    fact wifi_channel "$CH"; fact wifi_phy "$PHY"
    RSSI=$(echo "$SIG" | awk '{print $1}' | tr -d '-')
    if [ -n "$RSSI" ] && [ "$RSSI" -gt 75 ] 2>/dev/null; then
      warn "電波が弱い（RSSI -${RSSI}dBm）— 途切れやすい"
      finding 40 warn "Wi-Fiの電波が弱い (-${RSSI}dBm)" "AP に近づくか有線/テザリングへ"
    fi
  fi

  # DNS
  DNS_LIST=$(scutil --dns 2>/dev/null | awk '/nameserver\[/{print $3}' | sort -u | head -4 | paste -sd, -)
  fact dns "$DNS_LIST"
  [ -n "$DNS_LIST" ] && info "DNS           : $DNS_LIST" || {
    warn "DNS サーバが設定されていない"
    finding 10 critical "DNS未設定" "DHCPを更新するか DNS を 1.1.1.1 に手動設定"
  }

  # グローバル IP と出口（Cloudflare の trace。余計な情報は送らない）
  TRACE=$(curl -s --max-time 6 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null)
  if [ -n "$TRACE" ]; then
    GIP=$(echo "$TRACE"  | awk -F= '/^ip=/{print $2}')
    GLOC=$(echo "$TRACE" | awk -F= '/^loc=/{print $2}')
    COLO=$(echo "$TRACE" | awk -F= '/^colo=/{print $2}')
    WARP=$(echo "$TRACE" | awk -F= '/^warp=/{print $2}')
    fact global_ip "$GIP"; fact colo "$COLO"; fact loc "$GLOC"
    ok "グローバルIP  : ${BLD}$GIP${RST}  ${DIM}$GLOC / 出口 $COLO${RST}"
    [ "$WARP" = "on" ] && info "Cloudflare WARP が有効"
  else
    warn "グローバルIPを取れない（外へ出られていない可能性）"
  fi

  # Tailscale
  if [ -n "$TS_BIN" ]; then
    TSJ=$(run_bounded 8 "$TS_BIN" status --json 2>/dev/null)
    # tailscale の --json は整形出力なので "key": "value" と空白が入る。
    TS_STATE=$(echo "$TSJ" | sed -n 's/.*"BackendState"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    TS_IP=$(tailscale_ips | head -1)
    fact tailscale_state "$TS_STATE"; fact tailscale_ip "$TS_IP"
    if [ "$TS_STATE" = "Running" ]; then
      NPEER=$(run_bounded 8 "$TS_BIN" status 2>/dev/null | grep -c '^100\.')
      NDIRECT=$(run_bounded 8 "$TS_BIN" status 2>/dev/null | grep -c 'direct ')
      NRELAY=$(run_bounded 8 "$TS_BIN" status 2>/dev/null | grep -c 'relay ')
      ok "Tailscale     : $TS_IP  ${DIM}peers ${NPEER}（直結 $NDIRECT / 中継 ${NRELAY}）${RST}"
      if [ "$NRELAY" -gt 0 ] && [ "$NRELAY" -ge "$NDIRECT" ]; then
        info "中継経由のtailnetピアがあります（一般Webの経路とは区別）"
        finding 45 warn "一部tailnet通信が中継経由（一般のWeb通信とは別）" "該当ピアの転送が遅い場合に直結可否を確認。中継だけで回線全体の原因とは判定しない"
      fi
      EXIT_NODE=$(printf '%s' "$TSJ" | json_field ExitNodeStatus.ID)
      EXIT_ONLINE=$(printf '%s' "$TSJ" | json_field ExitNodeStatus.Online)
      fact exit_node "${EXIT_NODE:-}"; fact exit_node_online "${EXIT_ONLINE:-unknown}"
      OUTSIDE_IF=$(route -n get 1.1.1.1 2>/dev/null | awk '/interface:/{print $2}')
      fact external_if "$OUTSIDE_IF"
      if [ -n "$EXIT_NODE" ]; then
        info "exit node 選択中（稼働: ${EXIT_ONLINE:-不明} / 外部宛経路: $OUTSIDE_IF）"
      else
        info "Tailscale exit node: 未使用（通常通信の迂回は確認されず）"
      fi
    else
      info "Tailscale     : ${TS_STATE:-停止}"
      if [ -f "$TARGETS" ] && grep -qE 'http://100\.[0-9]' "$TARGETS"; then
        warn "tailnet 上のLLMを見に行く設定なのに Tailscale が止まっている"
        finding 10 critical "Tailscaleが停止中" "tailscale up（tailnet先のLLMには到達できません）"
      fi
    fi
  fi

  # プロキシと環境変数（LLM が繋がらない原因の常連）
  PROXY_ENV=$(env | grep -iE '^(http|https|all|no)_proxy=' | cut -d= -f1 | paste -sd' ' -)
  SYS_PROXY=$(scutil --proxy 2>/dev/null | awk '/HTTPEnable|HTTPSEnable/{print $3}' | grep -c '^1$')
  fact proxy_env "$PROXY_ENV"
  if [ -n "$PROXY_ENV" ]; then
    warn "プロキシ環境変数名（値は非表示）: ${DIM}$PROXY_ENV${RST}"
    finding 45 warn "proxy 環境変数が設定されている" "外して再試行: env -u HTTP_PROXY -u HTTPS_PROXY ..."
  fi
  [ "${SYS_PROXY:-0}" -gt 0 ] 2>/dev/null && {
    warn "システム設定にプロキシが入っている（scutil --proxy）"
    finding 45 warn "システムプロキシ有効" "設定 > ネットワーク > 詳細 > プロキシ を確認"
  }

  # IPv6。グローバルv6を持っているのに v6 が死んでいると、
  # 接続のたびに v6 を先に試して待たされる（happy eyeballs の失速）。
  V6ADDR=$(ifconfig "${DEFIF:-en0}" 2>/dev/null | awk '/inet6 [^f]/{print $2; exit}')
  V6GW=$(route -n get -inet6 default 2>/dev/null | awk '/gateway:/{print $2}')
  if [ -n "$V6ADDR" ]; then
    if run_bounded 4 ping6 -c 2 -i 0.3 2606:4700:4700::1111 >/dev/null 2>&1; then
      ok "IPv6          : $V6ADDR ${DIM}（到達OK）${RST}"
      fact ipv6 ok
    else
      info "IPv6          : ping応答なし（ICMP制限と通信障害は未分離）"
      fact ipv6 unverified
    fi
  else
    info "IPv6          : なし（v4のみ）"
    fact ipv6 none
  fi

  # 網の指紋と、同じ網での前回との比較
  NID=$(netid); fact netid "$NID"
  history_note "$NID"

  # 時計のずれ（数分ずれると TLS が落ちる）
  RDATE=$(curl -sI --max-time 6 https://www.cloudflare.com/ 2>/dev/null | awk -F': ' 'tolower($1)=="date"{print $2}' | tr -d '\r')
  if [ -n "$RDATE" ]; then
    RS=$(LC_ALL=C date -j -u -f "%a, %d %b %Y %H:%M:%S GMT" "$RDATE" "+%s" 2>/dev/null)
    if [ -n "$RS" ]; then
      SKEW=$(( $(date -u +%s) - RS )); [ "$SKEW" -lt 0 ] && SKEW=$(( -SKEW ))
      fact clock_skew "$SKEW"
      if [ "$SKEW" -gt 120 ]; then
        ng "時計が ${SKEW}秒 ずれている — TLS が失敗する原因"
        finding 20 critical "時計が${SKEW}秒ずれている" "sudo sntp -sS time.apple.com で合わせる"
      else
        ok "時刻          : ずれ ${SKEW}秒"
      fi
    fi
  fi
}

# ─── 2. 回線の質 ─────────────────────────────────────────
. "$NETDOC_DIR/lib/quality.sh"

# ─── 3. LLM に届くか（段階で切り分ける）──────────────────
PUBLIC_CA='Let.s Encrypt|DigiCert|GlobalSign|Amazon|Google Trust|Sectigo|ISRG|Baltimore|USERTrust|GTS |Cloudflare Inc'

url_host() { echo "$1" | sed -E 's#^[a-z]+://##; s#/.*$##; s#:[0-9]+$##'; }
url_port() {
  local u="$1" h; h=$(echo "$u" | sed -E 's#^[a-z]+://##; s#/.*$##')
  case "$h" in *:*) echo "${h##*:}" ;;
  *) case "$u" in https://*) echo 443 ;; *) echo 80 ;; esac ;; esac
}

probe_target() {
  # probe_target "表示名" "URL" "種別"
  local name="$1" url="$2" kind="$3"
  local host port scheme
  host=$(url_host "$url"); port=$(url_port "$url")
  case "$url" in https://*) scheme=https ;; *) scheme=http ;; esac

  local stage_dns="-" stage_tcp="-" stage_tls="-" stage_http="-" extra="" bad=0

  # DNS
  if echo "$host" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$|^localhost$'; then
    stage_dns="不要"
  else
    local a1 a2
    a1=$(dig +short +time=3 +tries=1 "$host" 2>/dev/null | grep -E '^[0-9]+\.' | head -1)
    if [ -n "$a1" ]; then
      stage_dns="$a1"
      a2=$(dig +short +time=3 +tries=1 @1.1.1.1 "$host" 2>/dev/null | grep -E '^[0-9]+\.' | head -3)
      if [ -n "$a2" ] && ! echo "$a2" | grep -q "^$a1$"; then
        # CDNやsplit DNSでは正当な回答差がある。公開DNSは権威ではない。
        if echo "$host" | grep -qvE '\.local$'; then
          extra="${extra}DNS応答が公開DNSと不一致 "
          extra="${extra}CDNやsplit DNSでも回答は異なる "
        fi
      fi
    else
      stage_dns="✗"; bad=1
      finding 10 critical "名前解決できない ($host)" "複数ドメインとシステムDNSを照合し、該当する修復候補を確認"
    fi
  fi

  # TCP
  if [ "$bad" -eq 0 ]; then
    if nc -z -G 4 -w 4 "$host" "$port" >/dev/null 2>&1; then
      stage_tcp="開"
    else
      stage_tcp="✗"; bad=1
      case "$host" in
        127.0.0.1|localhost) finding 10 critical "ローカルの $port が閉じている ($name)" "そのサーバが起動しているか確認" ;;
        100.*) finding 10 critical "tailnet先の $host:$port に繋がらない ($name)" "相手機の起動と listen アドレス(0.0.0.0)を確認" ;;
        *) finding 10 critical "$host:$port が塞がれている" "ファイアウォール/ゲストネットのポート制限。テザリングで確認" ;;
      esac
    fi
  fi

  # TLS
  if [ "$bad" -eq 0 ] && [ "$scheme" = https ]; then
    local out issuer verify
    out=$(echo | run_bounded 8 openssl s_client -connect "$host:$port" -servername "$host" \
          -verify_return_error 2>&1 | head -60)
    issuer=$(echo "$out" | sed -n 's/^issuer=//p' | head -1)
    [ -z "$issuer" ] && issuer=$(echo "$out" | sed -n 's/.*issuer: //p' | head -1)
    verify=$(echo "$out" | sed -n 's/^ *Verify return code: //p' | head -1)
    if echo "$out" | grep -q "CONNECTED" && [ -n "$issuer" ]; then
      stage_tls="OK"
      if ! echo "$issuer" | grep -qE "$PUBLIC_CA"; then
        stage_tls="要確認"
        extra="${extra}証明書の発行者=${issuer} "
        extra="${extra}発行者の一覧未登録だけでは傍受と判定できない "
      fi
    else
      stage_tls="要確認"
      extra="${extra}opensslで検証未完了、curlの結果も確認 "
    fi
  fi

  # HTTP（種別ごとに「生きているか分かる場所」を叩く）
  if [ "$bad" -eq 0 ]; then
    local w code ttot ttfb http_rc probe_url="$url"
    case "$kind" in
      ollama) probe_url="$url/api/tags" ;;
      openai) curl -s -o /dev/null --max-time 4 "$url/healthz" 2>/dev/null \
                && probe_url="$url/healthz" || probe_url="$url/v1/models" ;;
    esac
    w=$(curl -s -o /dev/null --max-time 12 \
        -w '%{http_code} %{time_starttransfer} %{time_total}' "$probe_url" 2>/dev/null)
    http_rc=$?
    code=$(echo "$w" | awk '{print $1}')
    ttfb=$(echo "$w" | awk '{print $2}'); ttot=$(echo "$w" | awk '{print $3}')
    # LLM で効くのは「最初のバイトまで」。全体時間よりこちらを見る。
    stage_http="$code $(msec "$ttfb")ms"
    if [ "$http_rc" -eq 0 ] && [ "$scheme" = https ]; then stage_tls="OK"; fi
    if [ "$http_rc" -ne 0 ]; then
      stage_http="✗(curl $http_rc)"; bad=1
      finding 10 critical "HTTPS/HTTP測定が完了しない ($host / curl $http_rc)" "DNS・証明書・接続・タイムアウトの測定結果を確認"
    fi
    case "$code" in
      000) stage_http="✗"; bad=1
           finding 10 critical "HTTPが返らない ($host)" "タイムアウトやサーバー・経路の障害を切り分ける" ;;
      407) bad=1; finding 10 critical "プロキシ認証を要求されている ($host)" "社内プロキシの資格情報が必要" ;;
      5*)  finding 30 warn "サーバ側が $code を返す ($host)" "相手側の問題。時間をおいて再試行" ;;
      401) extra="${extra}要認証(サーバは生きている) " ;;
      403) extra="${extra}403(APIルートでは正常なことが多い) " ;;
      404) extra="${extra}404(APIルートでは正常) " ;;
    esac
  fi

  # 種別ごとの中身の確認
  if [ "$bad" -eq 0 ]; then
    case "$kind" in
      ollama)
        local tags n ps loaded
        tags=$(curl -s --max-time 8 "$url/api/tags" 2>/dev/null)
        n=$(echo "$tags" | grep -o '"name"' | wc -l | tr -d ' ')
        if [ "${n:-0}" -gt 0 ]; then extra="${extra}モデル${n}本 "
        else extra="${extra}応答はするがモデル一覧が読めない "; fi
        # 読み込み済みが無い＝初回の応答は数秒〜数十秒かかる。
        # 「繋がらない」の正体がこれであることは多い（実測でTTFB 6.5秒）。
        ps=$(curl -s --max-time 6 "$url/api/ps" 2>/dev/null)
        loaded=$(echo "$ps" | grep -o '"name"' | wc -l | tr -d ' ')
        if [ "${loaded:-0}" -eq 0 ]; then
          extra="${extra}${YLW}未ロード${RST} "
          finding 50 warn "$name はモデルを読み込んでいない" \
            "初回の応答に数秒〜数十秒かかります。常駐させるなら OLLAMA_KEEP_ALIVE=-1"
        else
          extra="${extra}ロード済${loaded} "
        fi ;;
      openai)
        local m n
        m=$(curl -s --max-time 8 "$url/v1/models" 2>/dev/null)
        n=$(echo "$m" | grep -o '"id"' | wc -l | tr -d ' ')
        [ "${n:-0}" -gt 0 ] && extra="${extra}モデル${n}本 " ;;
    esac
  fi

  # 表示
  local sym="${GRN}✓${RST}"; [ "$bad" -eq 1 ] && sym="${RED}✗${RST}"
  echo "$extra" | grep -q '傍受\|不一致' && sym="${YLW}!${RST}"
  printf "  %s %s" "$sym" "$name"
  local _w; _w=$(dwidth "$name")
  while [ "$_w" -lt 22 ]; do printf ' '; _w=$((_w+1)); done
  printf "${DIM}DNS${RST} %-16s ${DIM}TCP${RST} %-4s ${DIM}TLS${RST} %-7s ${DIM}HTTP${RST} %-11s ${DIM}%s${RST}\n" \
    "$stage_dns" "$stage_tcp" "$stage_tls" "$stage_http" "$extra"
  fact "target_$name" "$stage_dns|$stage_tcp|$stage_tls|$stage_http|$extra"
  return $bad
}

section_llm() {
  step "3. LLM に届くか ${DIM}（DNS → TCP → TLS → HTTP のどこで死ぬか）${RST}"
  [ -f "$TARGETS" ] || seed_targets

  # 並列に叩く。壊れている網ほど1件あたりのタイムアウトが効いてくるので、
  # 直列だと「調べるのに時間がかかって余計に困る」状態になる。
  PDIR="$(mktemp -d -t netdoc.p)"
  i=0; ORDER=""
  while IFS='|' read -r name url kind; do
    name=$(echo "$name" | sed 's/^ *//; s/ *$//')
    url=$(echo "$url"   | sed 's/^ *//; s/ *$//')
    kind=$(echo "$kind" | sed 's/^ *//; s/ *$//')
    case "$name" in ''|\#*) continue ;; esac
    [ -z "$url" ] && continue
    i=$((i+1)); ORDER="$ORDER $i"
    ( probe_target "$name" "$url" "${kind:-http}" >"$PDIR/$i" 2>/dev/null ) &
  done <"$TARGETS"
  wait
  for n in $ORDER; do [ -f "$PDIR/$n" ] && cat "$PDIR/$n"; done
  rm -rf "$PDIR"

  # 失敗数は記録された事実から数える（背景ジョブの終了コードは拾えないため）
  LLM_BAD=$(awk -F'\t' '$1 ~ /^target_/ && $2 ~ /✗/ {c++} END{print c+0}' "$FACTS")
  fact llm_bad "$LLM_BAD"

  section_captive

  # 「繋がらない」の正体が認証だった、を切り分ける
  if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    warn "ANTHROPIC_API_KEY が環境変数に入っている"
    note "これがサブスクのOAuthより優先され、古い/失効した鍵だと 401 になる"
    note "回線ではなく認証の問題。外して試す: unset ANTHROPIC_API_KEY"
    finding 30 warn "ANTHROPIC_API_KEY が設定されている" "unset して再試行（401は回線問題ではない）"
  fi
  for f in "$HOME/.claude/.credentials.json" "$HOME/.config/claude/auth.env"; do
    [ -f "$f" ] && info "認証情報            : $(basename "$f") あり ${DIM}(中身は見ていない)${RST}"
  done
}

# Captive portal checks are also useful for general connectivity without probing LLMs.
section_captive() {
  local cap code rc file
  file=$(mktemp -t netdoc.captive) || return 1
  rc=0
  code=$(curl --noproxy '*' -s -o "$file" --max-time 5 -w '%{http_code}' http://captive.apple.com/ 2>/dev/null) || rc=$?
  cap=$(tr -d '\r\n' <"$file"); rm -f "$file"
  if [ "$rc" = 0 ] && [ "$code" = 200 ] && printf '%s' "$cap" | grep -qi '<title>Success</title>'; then
    ok "captive portal: 検出されず"; fact captive no
  elif [ "$rc" = 0 ]; then
    warn "captive portal: ログイン画面やHTTP制限の可能性 (HTTP $code)"
    fact captive possible
    finding 35 warn "ネットワークのログイン画面またはHTTP制限の可能性" "ブラウザで http://captive.apple.com/ を開き、接続条件を確認"
  else
    info "captive portal: 測定不成立 (curl $rc)、ログインが必要とは未確定"
    fact captive unknown
  fi
}

# ─── 4. 所見 ─────────────────────────────────────────────
section_verdict() {
  step "4. 所見"
  if [ ! -s "$FIND" ]; then
    printf "  ${GRN}${BLD}今回の測定範囲では明確な異常は見つかりませんでした。${RST}\n"
    return 0
  fi
  NCRIT=$(awk -F'\t' '$2=="critical"' "$FIND" | wc -l | tr -d ' ')
  NWARN=$(awk -F'\t' '$2=="warn"' "$FIND" | wc -l | tr -d ' ')
  fact critical_count "$NCRIT"; fact warn_count "$NWARN"

  # 全部を並べるより、まず1つ名指しする。並べるのはその後。
  SORTED="$(mktemp -t netdoc.sorted)"
  sort -n -k1,1 "$FIND" >"$SORTED"
  TOP=$(head -1 "$SORTED"); TP=$(echo "$TOP" | cut -f1)

  if [ "${TP:-99}" -le 30 ] 2>/dev/null; then
    printf "  ${BLD}いちばんありそうな原因${RST}\n"
    printf "    ${RED}%s${RST}\n" "$(echo "$TOP" | cut -f3)"
    printf "    ${DIM}→ %s${RST}\n" "$(echo "$TOP" | cut -f4)"
    fact top_cause "$(echo "$TOP" | cut -f3)"
    REST=$(tail -n +2 "$SORTED"); LABEL="ほかに見えているもの"
  else
    # 通信そのものは成立している。原因だと断定しない。
    printf "  ${GRN}通信を妨げている決定的な問題は見つかりませんでした。${RST}\n"
    REST=$(cat "$SORTED"); LABEL="気になる点"
  fi

  if [ -n "$REST" ]; then
    printf "\n  ${DIM}%s${RST}\n" "$LABEL"
    echo "$REST" | while IFS=$'\t' read -r prio sev title fix; do
      m="${YLW}●${RST}"; [ "$sev" = critical ] && m="${RED}●${RST}"
      printf "  %s %s\n" "$m" "$title"
      printf "    ${DIM}→ %s${RST}\n" "$fix"
    done
  fi
  rm -f "$SORTED"
  return 1
}

