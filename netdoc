# ─── 出力（機械可読・レポート）────────────────────────────
emit_report() {
  {
    echo "# netdoc レポート"
    echo
    echo "- 取得: $NOW"
    echo "- ホスト: $(hostname)"
    echo
    echo "## いまどこに居るか"
    echo
    echo '| 項目 | 値 |'
    echo '|---|---|'
    for k in default_if gateway interfaces wifi_ssid wifi_signal wifi_rate dns global_ip loc colo tailscale_state tailscale_ip proxy_env clock_skew; do
      v=$(getf "$k"); [ -n "$v" ] && echo "| $k | \`$v\` |"
    done
    echo
    echo "## 回線の質"
    echo
    echo '| 項目 | 値 |'
    echo '|---|---|'
    for k in bottleneck bottleneck_confidence bottleneck_limit gw_rtt gw_loss rtt jitter loss external2_rtt external2_loss dns_status dns_ms mtu_if mtu_observation down_mbps up_mbps single_down_mbps idle_ms loaded_down_ms loaded_up_ms loaded_gw_rtt loaded_gw_loss process_top process_top_mbps; do
      v=$(getf "$k"); [ -n "$v" ] && echo "| $k | \`$v\` |"
    done
    echo
    echo "## LLM への疎通"
    echo
    echo '| 宛先 | DNS | TCP | TLS | HTTP | 備考 |'
    echo '|---|---|---|---|---|---|'
    awk -F'\t' '$1 ~ /^target_/ {
      n=substr($1,8); split($2,p,"|");
      printf "| %s | %s | %s | %s | %s | %s |\n", n,p[1],p[2],p[3],p[4],p[5] }' "$FACTS"
    echo
    if [ -s "$FIND" ]; then
      echo "## 所見"
      echo
      sort -n -k1,1 "$FIND" | while IFS=$'\t' read -r prio sev title fix; do
        m="⚠️"; [ "$sev" = critical ] && m="🔴"
        echo "- $m **$title**"
        echo "  - → $fix"
      done
    else
      echo "## 所見"; echo; echo "問題なし。"
    fi
  } >"$REPORT_PATH"
}

# ─── 本体 ────────────────────────────────────────────────
header() {
  [ "$MODE" = json ] && return
  [ -t 1 ] && clear 2>/dev/null || true
  printf "${BLD}🩺 netdoc${RST} ${DIM}v%s — ネットワーク診断＆修復${RST}\n" "$VERSION"
  printf "${DIM}%s  mode=%s${RST}\n" "$NOW" "$MODE"
  hr
}

section_stream() {
  # 実際に1トークン生成させて「最初の1文字が返るまで」を測る。
  # LLMで体感を決めるのはここ。★モデルを起こすので明示指定のときだけ実行する。
  step "ストリーミングの初動 ${DIM}（実際に生成させます）${RST}"
  [ -f "$TARGETS" ] || seed_targets
  local any=0
  while IFS='|' read -r name url kind; do
    name=$(echo "$name" | sed 's/^ *//; s/ *$//')
    url=$(echo "$url"   | sed 's/^ *//; s/ *$//')
    kind=$(echo "$kind" | sed 's/^ *//; s/ *$//')
    case "$name" in ''|\#*) continue ;; esac
    [ "$kind" = ollama ] || continue
    any=1
    local model w ttfb tot loaded
    loaded=$(curl -s --max-time 6 "$url/api/ps" 2>/dev/null \
             | sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    model="$loaded"
    [ -z "$model" ] && model=$(curl -s --max-time 6 "$url/api/tags" 2>/dev/null \
             | sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    [ -z "$model" ] && { warn "$name : モデルが見つかりません"; continue; }
    w=$(curl -s -o /dev/null --max-time 120 -w '%{time_starttransfer} %{time_total}' \
        -H 'content-type: application/json' \
        -d "{\"model\":\"$model\",\"prompt\":\"a\",\"stream\":true,\"options\":{\"num_predict\":1}}" \
        "$url/api/generate" 2>/dev/null)
    ttfb=$(echo "$w" | awk '{printf "%.2f", $1}'); tot=$(echo "$w" | awk '{printf "%.2f", $2}')
    if awk -v t="$ttfb" 'BEGIN{exit !(t>3)}'; then
      warn "$name : 初トークンまで ${BLD}${ttfb}秒${RST}  ${DIM}$model ${loaded:+(ロード済)}${RST}"
      note "冷えた状態からの読み込み。常駐させるなら OLLAMA_KEEP_ALIVE=-1"
      finding 30 warn "$name の初トークンが ${ttfb}秒" "OLLAMA_KEEP_ALIVE=-1 で常駐させる"
    else
      ok "$name : 初トークンまで ${BLD}${ttfb}秒${RST}  ${DIM}$model${RST}"
    fi
    fact "ttft_$name" "$ttfb"
  done <"$TARGETS"
  [ "$any" -eq 0 ] && info "ollama 種別の宛先がありません（netdoc --discover で探せます）"
}

show_history() {
  header
  step "この網での記録"
  [ -f "$HISTORY" ] || { info "まだ記録がありません"; exit 0; }
  NID=$(netid)
  printf "  ${DIM}%-19s %-10s %8s %7s %9s %6s${RST}\n" 日時 網 遅延ms DNSms 下りMbps 失敗
  awk -F'\t' -v k="$NID" '$2==k' "$HISTORY" | tail -20 \
    | awk -F'\t' '{printf "  %-19s %-10s %8s %7s %9s %6s\n", $1, ($3==""?"(有線)":$3), $4, $5, $6, $8}'
  echo
  info "全部の網を見るには: cat $HISTORY"
}

discover() {
  # 手元と tailnet から LLM サーバらしきものを探す。
  # ポートは ollama / LM Studio / llama.cpp / persona-node の既定値。
  header
  step "LLMサーバを探す"
  [ -f "$TARGETS" ] || seed_targets
  FOUND="$(mktemp -t netdoc.disc)"

  probe_port() { # ip port kind label
    local ip="$1" port="$2" kind="$3" label="$4" url="http://$1:$2" n=""
    nc -z -G 1 -w 1 "$ip" "$port" >/dev/null 2>&1 || return 1
    case "$kind" in
      ollama) n=$(curl -s --max-time 4 "$url/api/tags" 2>/dev/null | grep -o '"name"' | wc -l | tr -d ' ') ;;
      openai) n=$(curl -s --max-time 4 "$url/v1/models" 2>/dev/null | grep -o '"id"' | wc -l | tr -d ' ') ;;
    esac
    [ "${n:-0}" -eq 0 ] && return 1
    printf '%s\t%s\t%s\t%s\n' "$label" "$url" "$kind" "$n" >>"$FOUND"
    ok "$(printf '%-26s %-30s モデル%s本' "$label" "$url" "$n")"
    return 0
  }

  info "手元を見ています…"
  for spec in "11434 ollama ollama" "1234 openai LMStudio" "8080 openai llama.cpp" "8787 openai persona-node"; do
    set -- $spec
    probe_port 127.0.0.1 "$1" "$2" "$3 (ローカル)"
  done

  if [ -n "$TS_BIN" ]; then
    NP=$(tailscale_peers | wc -l | tr -d ' ')
    info "tailnet の $NP 台を見ています…（1台1秒まで）"
    SELF=$("$TS_BIN" ip -4 2>/dev/null | head -1)
    tailscale_peers | while IFS=$'\t' read -r ip host; do
      [ "$ip" = "$SELF" ] && continue
      for spec in "11434 ollama ollama" "1234 openai LMStudio" "8787 openai persona-node"; do
        set -- $spec
        probe_port "$ip" "$1" "$2" "$3 @$host"
      done
    done
  fi

  hr
  if [ ! -s "$FOUND" ]; then
    warn "見つかりませんでした。"
    note "相手機の LLM が 0.0.0.0 で listen しているか確認してください"
    note "（ollama なら OLLAMA_HOST=0.0.0.0:11434）"
    rm -f "$FOUND"; exit 0
  fi
  N=$(wc -l <"$FOUND" | tr -d ' ')
  ADDED=0
  while IFS=$'\t' read -r label url kind n; do
    grep -qF "$url" "$TARGETS" && continue
    printf '%-18s | %-34s | %s\n' "$label" "$url" "$kind" >>"$TARGETS"
    ADDED=$((ADDED+1))
  done <"$FOUND"
  ok "$N 件見つけ、$ADDED 件を $TARGETS に追記しました"
  note "以後 netdoc --llm で毎回まとめて疎通を見ます"
  rm -f "$FOUND"
}

# Source-only entrypoint for isolated tests; initialization creates temporary facts only.
[ "${NETDOC_LIBRARY_ONLY:-0}" = 1 ] && return 0 2>/dev/null

case "$MODE" in
  restore)     restore_changes "$RESTORE_ID"; exit $? ;;
  pause)       pause_process "$PAUSE_PID" "$PAUSE_SEC"; exit $? ;;
  history)     show_history; exit 0 ;;
  stream)      header; section_where >/dev/null; section_stream; section_verdict; exit $? ;;
  discover)    discover; exit 0 ;;
  restore-dns) restore_dns; exit $? ;;

  targets)
    [ -f "$TARGETS" ] || seed_targets
    printf "${BLD}調べに行く先${RST}  ${DIM}%s${RST}\n\n" "$TARGETS"
    cat "$TARGETS"
    printf "\n${DIM}このファイルを編集すれば、自分のLLMサーバも面倒を見ます。${RST}\n"
    exit 0 ;;

  where)  header; section_where; exit 0 ;;
  speed)  header; section_where >/dev/null; section_quality; history_save; section_verdict; exit $? ;;
  llm)    header; section_where >/dev/null; section_llm; section_verdict; exit $? ;;

  json)
    section_where; section_quality; section_llm; history_save; section_verdict
    emit_json; exit 0 ;;

  report)
    header; section_where; section_quality; section_llm; history_save; section_verdict
    emit_report
    hr; printf "${GRN}レポート: %s${RST}\n" "$REPORT_PATH"; exit 0 ;;

  watch)
    printf "${BLD}🩺 netdoc --watch${RST} ${DIM}%s秒ごと。変化したときだけ出します。Ctrl-C で終了${RST}\n" "$WATCH_SEC"
    LAST=""
    while :; do
      : >"$FACTS"; : >"$FIND"
      section_where >/dev/null 2>&1
      section_llm   >/dev/null 2>&1
      SIG="$(getf global_ip)|$(getf llm_bad)|$(getf captive)|$(getf wifi_ssid)"
      if [ "$SIG" != "$LAST" ]; then
        printf "\n${DIM}%s${RST}  " "$(date '+%H:%M:%S')"
        if [ "$(getf llm_bad)" = "0" ] && [ "$(getf captive)" = "no" ]; then
          printf "${GRN}正常${RST}  ip=%s %s\n" "$(getf global_ip)" "$(getf wifi_ssid)"
        else
          printf "${RED}異常${RST}  失敗%s件  ip=%s %s\n" "$(getf llm_bad)" "$(getf global_ip)" "$(getf wifi_ssid)"
          sort -n -k1,1 "$FIND" | awk -F'\t' '{printf "           → %s\n", $3}'
        fi
        LAST="$SIG"
      fi
      sleep "$WATCH_SEC"
    done ;;
esac

header
section_where
section_quality
case "$MODE" in
  fix|auto|plan) section_captive ;;
  *) section_llm ;;
esac
history_save
VERDICT_STATUS=0
section_verdict || VERDICT_STATUS=$?
case "$MODE" in
  check|full) exit "$VERDICT_STATUS" ;;
  plan) section_repair; exit "$VERDICT_STATUS" ;;
esac
section_repair
RETEST_STATUS=0
section_retest || RETEST_STATUS=$?
if [ "$RETEST_STATUS" = 0 ]; then
  case "$MODE" in fix|auto) performance_retest || RETEST_STATUS=$? ;; esac
fi
exit "$RETEST_STATUS"
